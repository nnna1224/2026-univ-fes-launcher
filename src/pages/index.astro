---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameCard from '../components/GameCard.astro';
import { site } from '../config/site';
import LauncherPanel from '../components/LauncherPanel.astro';
import { publishedGames } from '../utils/games';

const games = await publishedGames();
---
<BaseLayout>
  <section class="hero container">
    <h1 class="hero__title">{site.festivalName}</h1>
  </section>

  <LauncherPanel games={games} />

  <section id="games" class="section container" aria-labelledby="games-heading">
    <h2 id="games-heading" class="headline">出展ゲーム</h2>
    {games.length > 0 ? (
      <div class="card-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    ) : (
      <p class="body-large">公開中の作品はまだありません。</p>
    )}
  </section>
</BaseLayout>
