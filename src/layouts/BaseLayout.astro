---
import { site } from '../config/site';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.name, description = site.intro } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/png" href={withBase('/icon.png')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="top-app-bar">
      <div class="container">
        <a class="top-app-bar__title" href={withBase('/')} aria-label={site.name}><img src={withBase('/icon.png')} alt="" width="40" height="40" />お品書き</a>
        <nav aria-label="メインナビゲーション">
          {site.links[0] && <a class="btn btn--text" href={site.links[0].url} target="_blank" rel="noopener noreferrer">{site.links[0].label}</a>}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} {site.groupName}</div>
    </footer>
  </body>
</html>
